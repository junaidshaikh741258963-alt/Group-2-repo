# ---------------------------------------------------------------------------
# Database (MySQL 8.x). Create the schema and user first; see README.
# Never commit a real .env file.
# ---------------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/ai_website_builder?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
DB_USERNAME=awb
DB_PASSWORD=change-me

# Separate schema used by backend integration tests (never the app schema).
TEST_DB_URL=jdbc:mysql://localhost:3306/ai_website_builder_test?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
TEST_DB_USERNAME=awb
TEST_DB_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Gemini provider bootstrap (optional). If no provider is configured in the
# database, these values seed it on first start. Keys saved in Settings are
# encrypted at rest and take precedence.
# GEMINI_MODEL must be a model ID your key actually exposes.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ACTIVE_PROVIDER=gemini

# 32 random bytes, base64 encoded. Required before provider keys can be saved.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AWB_ENCRYPTION_KEY=

# Server
SERVER_PORT=8080
AWB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AWB_MAX_OUTPUT_TOKENS=32000
AWB_PROVIDER_TIMEOUT_SECONDS=180

# External coding agent (bridge). Workspaces live outside the repository so an
# editor or agent can work in them without touching the app source.
# AWB_BRIDGE_ROOT=%USERPROFILE%\.ai-website-builder\agent-workspaces

# Agent (optional). The agent can use copy/batch and up to 64 tool calls per run.
# AWB_AGENT_MAX_STEPS=64
# AWB_AGENT_COMMANDS_ENABLED=true
# AWB_AGENT_ALLOWED_COMMANDS=npm,npx,node,mvn,mvnw,java,python,python3,pytest,gradle,gradlew

# Optional: only set when you want explicit fallback to another configured provider.
# AWB_FALLBACK_PROVIDER=
